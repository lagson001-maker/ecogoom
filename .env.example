# --- Supabase (required) ------------------------------------------------------
# Project Settings -> API. The publishable (anon) key is safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. NOT used by the running app today (RLS + user session cover
# every V1 operation). Only needed for admin scripts. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL, used for auth email redirects (magic link / confirm).
# Netlify sets URL automatically; this overrides it when present.
NEXT_PUBLIC_SITE_URL=http://localhost:4310

# --- AI (optional) ------------------------------------------------------------
# Leave empty to run without AI: text search falls back to keyword/tag matching
# and image analysis shows "AI image analysis is not configured".
# AI_PROVIDER: anthropic (default when a key is set). Add others in lib/ai/index.ts.
AI_PROVIDER=
# Defaults to claude-opus-5-5
AI_MODEL=
AI_API_KEY=
